PORT=5000

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
MONGODB_DB_NAME=mail_tracker

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://mail-tracker-mu.vercel.app/auth/google/callback

# Session / token encryption (use a strong random value)
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# Public origin used to build absolute URLs (pixel, auth redirects)
APP_ORIGIN=https://mail-tracker-mu.vercel.app
